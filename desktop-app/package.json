  "description": "Tenura agent demo as a desktop app",
  "main": "main.js",
  "author": "Tenura",
  "license": "UNLICENSED",
  "scripts": { "start": "electron .", "dist": "electron-builder" },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
